# OnchainKit API Key
# Get yours at: https://portal.cdp.coinbase.com/projects/api-keys
VITE_ONCHAINKIT_API_KEY=your_onchainkit_api_key_here

# Paymaster URL for Gasless Transactions (Optional)
# Get yours at: https://portal.cdp.coinbase.com/products/bundler-and-paymaster
# Format: https://api.developer.coinbase.com/rpc/v1/base/your_paymaster_key
VITE_PAYMASTER_URL=

# WalletConnect Project ID (Optional, for WalletConnect support)
# Get yours at: https://cloud.walletconnect.com/
VITE_CELO_MILITIA_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_WALLETCONNECT_PROJECT_ID=

# Gemini API Key for AI Features
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis Configuration
# Get yours at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# On-Chain Configuration

# Migration: set these to the OLD contract addresses before running scripts/migrate.cjs
OLD_BASE_CONTRACT=0x0000000000000000000000000000000000000000
OLD_CELO_CONTRACT=0x0000000000000000000000000000000000000000

# Contract Verification API Keys (for scripts/verify.cjs)
# Basescan: https://basescan.org/myapikey
BASESCAN_API_KEY=
# Celoscan: https://celoscan.io/myapikey
CELOSCAN_API_KEY=
